+    device const float * dt = (device const float *) ((device const char *) src2 + ir*args.nb20 + i3*args.nb22);
+    device const float * B  = (device const float *) ((device const char *) src4 + g*args.nb41 + i3*args.nb43) + 4*tiisg;
+    device const float * C  = (device const float *) ((device const char *) src5 + g*args.nb51 + i3*args.nb53) + 4*tiisg;
