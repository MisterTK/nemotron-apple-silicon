+                !ggml_metal_buffer_is_shared((ggml_metal_buffer_t) ids->buffer->context)) {
+                return false;
+            }
+
+            const int64_t row_size = dst->nb[1];
+            const int64_t head     = dst->view_offs / row_size;    // first written row
+            const int64_t slot_rows = dst->nb[2] / row_size;       // rows between snapshot slots (mem_size)
