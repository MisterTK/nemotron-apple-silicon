+// SSM_SCAN + CPY: the scan writes its final state (and rollback snapshots) straight into the
+// recurrent cache instead of the tail of its output, and the cpy is skipped
+static bool ggml_metal_fusion_check_ssm_scan_cache(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * scan = nodes[0];
+    const ggml_tensor * cpy  = nodes[fusion->ops.size() - 1];
+
+    // the graph optimizer also sees build_rs's extra-state GET_ROWS + CPY between the scan and the
+    // state cpy; at decode they have no elements, so the encoders (which skip empty nodes) see SSM_SCAN + CPY
+    if (fusion->ops.size() == 4 && (!ggml_is_empty(nodes[1]) || !ggml_is_empty(nodes[2]))) {
+        return false;
+    }
+
+    if (scan->type != GGML_TYPE_F32 || (scan->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    if (cpy->op != GGML_OP_CPY || (cpy->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const ggml_tensor * x = scan->src[1];
+
+    const int64_t D         = scan->src[0]->ne[0]*scan->src[0]->ne[1]*scan->src[0]->ne[2]; // d_state*head_dim*n_head
+    const int64_t n_tokens  = x->ne[2];
+    const int64_t n_seqs    = x->ne[3];
+    const int64_t K         = ggml_get_op_params_i32(scan, 0);
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+    const size_t  tail_off  = ggml_nelements(x)*sizeof(float);
+
+    const ggml_tensor * src = cpy->src[0]; // scan state tail view
+    const ggml_tensor * dst = cpy->src[1]; // cache view
+
+    if (src->op != GGML_OP_VIEW || src->view_src != scan ||
+        src->view_offs != tail_off || !ggml_is_contiguous(src) ||
+        ggml_nelements(src) != D*n_seqs*n_written) {
+        return false;
+    }
+
+    const int64_t expected_ne[GGML_MAX_DIMS] = { D, n_seqs, n_written, 1 };
+    if (dst->type != GGML_TYPE_F32 ||
+        !std::equal(expected_ne, expected_ne + GGML_MAX_DIMS, dst->ne) ||
+        dst->nb[0] != ggml_type_size(GGML_TYPE_F32) ||
+        dst->nb[1] != ggml_row_size(GGML_TYPE_F32, D)) {
+        return false;
+    }
