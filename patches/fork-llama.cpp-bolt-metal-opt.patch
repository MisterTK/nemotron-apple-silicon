+void ggml_vec_dot_iq2_xxs_u3_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QK_K == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_iq2_xxs_u3 * GGML_RESTRICT x = vx;
+    const block_q8_K       * GGML_RESTRICT y = vy;
+
+    const int nb = n / QK_K;
+
+    float sumf = 0.f;
+    for (int i = 0; i < nb; ++i) {
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d) * y[i].d;
+        const int8_t * GGML_RESTRICT q8 = y[i].qs;
+        int32_t bsum = 0;
+        for (int ib32 = 0; ib32 < QK_K/32; ++ib32) {
+            const uint32_t * q = x[i].qs + 3*ib32;
+            const int32_t ls = 2*((x[i].scales >> 4*ib32) & 15) + 1;
+            int32_t sumi = 0;
+            for (int j = 0; j < 30; ++j) {
+                sumi += (int32_t)(2*((q[j/10] >> 3*(j%10)) & 7) - 5) * q8[j];
+            }
+            const int32_t n30 = (q[0] >> 30) | (((q[1] >> 30) & 1) << 2);
+            const int32_t n31 = (q[1] >> 31) | ((q[2] >> 30) << 1);
+            sumi += (2*n30 - 5) * q8[30] + (2*n31 - 5) * q8[31];
+            q8 += 32;
+            bsum += sumi * ls;
+        }
+        sumf += d * bsum;
+    }
+    *s = (17.f/16.f) * sumf;
+}
