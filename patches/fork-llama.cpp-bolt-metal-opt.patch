+        for (short i = 0; i < 10; ++i) n[4 + i]  = (q2 >> 3*i) & 7;
+        n[14] = (q0 >> 30) | (((q1 >> 30) & 1) << 2);
+        n[15] = (q1 >> 31) | ((q2 >> 30) << 1);
+    }
+    for (short i = 0; i < 16; ++i) {
+        reg[i/4][i%4] = dl * (2.f*n[i] - 5.f);
+    }
+}
