+// decode / speculative verify: the conv window (state + new tokens) of one channel stays in registers, so
+// the concatenated tensor is never materialized; the new state (and rollback snapshots) go straight to the cache
+kernel void kernel_ssm_conv_cat_f32(
+        constant ggml_metal_kargs_ssm_conv_cat & args,
+        device const  char * state,
+        device const  char * x,
+        device const  char * conv_w,
+        device const float * bias,
+        device        char * dst,
+        device        char * cache,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+    constexpr short NT_MAX = 16;
+
+    const int32_t ir = tgpig.x*ntg.x + tpitg.x;
+    const int32_t i3 = tgpig.z;
+
+    if (ir >= args.n_ch) {
+        return;
+    }
+
+    const short nc  = FC_ssm_conv_nc;
+    const short ncs = nc - 1;
+    const int32_t n_t = args.n_t;
+
+    float w[4 - 1 + NT_MAX];
+
+    FOR_UNROLL (short k = 0; k < 3; ++k) {
+        if (k < ncs) {
+            w[k] = *(device const float *) (state + k*args.nbs0 + ir*args.nbs1 + i3*args.nbs2);
+        }
+    }
+    for (int32_t t = 0; t < n_t; ++t) {
+        w[ncs + t] = *(device const float *) (x + t*args.nbx0 + ir*args.nbx1 + i3*args.nbx2);
+    }
+
+    device const float * c = (device const float *) (conv_w + ir*args.nb11);
+    float cw[4];
+    FOR_UNROLL (short k = 0; k < 4; ++k) {
+        if (k < nc) {
+            cw[k] = c[k];
+        }
+    }
+    const float b = bias[ir];
+
+    for (int32_t t = 0; t < n_t; ++t) {
+        // same arithmetic as kernel_ssm_conv_f32_f32(_4) followed by the bias add, so results are bit-identical
+        float sumf = 0.0f;
+        if (nc == 4) {
+            sumf = dot(float4(w[t], w[t + 1], w[t + 2], w[t + 3]), float4(cw[0], cw[1], cw[2], cw[3]));
+        } else {
+            FOR_UNROLL (short k = 0; k < 4; ++k) {
+                if (k < nc) {
+                    sumf += w[t + k]*cw[k];
+                }
+            }
+        }
+        sumf += b;
+        *(device float *) (dst + ir*args.nb0 + t*args.nb1 + i3*args.nb2) = sumf/(1.0f + exp(-sumf));
