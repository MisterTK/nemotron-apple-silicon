+    const uint32_t q0 = q[0], q1 = q[1], q2 = q[2];
+    float n[16];
+    if (h == 0) {
+        for (short i = 0; i < 10; ++i) n[i]      = (q0 >> 3*i) & 7;
+        for (short i = 0; i <  6; ++i) n[10 + i] = (q1 >> 3*i) & 7;
