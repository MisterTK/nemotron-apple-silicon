+    // slot s keeps the state after token n_t - 1 - s (slot 0 = final state)
+    for (int32_t s = 0; s < args.n_slots; ++s) {
+        device float * cs = (device float *) (cache + s*args.nbc2 + i3*args.nbc1) + ir*ncs;
+        FOR_UNROLL (short k = 0; k < 3; ++k) {
+            if (k < ncs) {
+                cs[k] = w[n_t - s + k];
+            }
+        }
+    }
