+// Mamba-2 conv step as built by mamba-base: concat(state, x^T), rolled windows copied into the conv cache (one per
+// snapshot slot), then ssm_conv + bias + silu. Each cpy writes into a view of the previous one (same cache, same
+// offsets as the model) only to keep the graph order concat, cpy x m, conv, add, silu.
+struct test_ssm_conv_cat_fusion : public test_case {
+    const int64_t n_ch;
+    const int64_t n_seq_tokens;
+    const int64_t n_seqs;
+    const int64_t K;
+
+    std::vector<ggml_tensor *> check_nodes;
+
+    std::string vars() override {
+        return VARS_TO_STR4(n_ch, n_seq_tokens, n_seqs, K);
+    }
+
+    test_ssm_conv_cat_fusion(int64_t n_ch = 10240, int64_t n_seq_tokens = 1, int64_t n_seqs = 1, int64_t K = 1)
+        : n_ch(n_ch), n_seq_tokens(n_seq_tokens), n_seqs(n_seqs), K(K) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t d_conv    = 4;
+        const int64_t mem_size  = n_seqs + 2;
+        const int64_t kv_head   = 1;
+        const int64_t n_written = std::min<int64_t>(n_seq_tokens, K);
+        const int64_t row_count = (d_conv - 1) * n_ch;
+        const size_t  row_size  = ggml_row_size(GGML_TYPE_F32, row_count);
+
+        ggml_tensor * state = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_conv - 1, n_ch, n_seqs);
+        ggml_tensor * xbc   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_ch, n_seq_tokens, n_seqs);
+        ggml_tensor * w     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, n_ch);
+        ggml_tensor * bias  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_ch);
+        // extra rows so the read-back view at the end fits after the last slot
+        const int64_t n_extra = (n_ch * n_seq_tokens * n_seqs + row_count - 1) / row_count;
+        ggml_tensor * cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row_count, mem_size * n_written + n_extra);
+        ggml_set_name(cache, "cache");
+
+        ggml_tensor * conv_x = ggml_concat(ctx, state, ggml_transpose(ctx, xbc), 0);
+
+        check_nodes.clear();
+        ggml_tensor * prev = cache;
+        size_t prev_offs = 0;
+        for (int64_t slot = 0; slot < n_written; ++slot) {
+            ggml_tensor * last_conv = ggml_view_3d(ctx, conv_x, d_conv - 1, n_ch, n_seqs, conv_x->nb[1], conv_x->nb[2],
+                                                   (n_seq_tokens - slot) * conv_x->nb[0]);
+            const size_t offs = ((size_t) slot * mem_size + kv_head) * row_size;
+            ggml_tensor * dst = ggml_view_2d(ctx, prev, row_count, n_seqs, cache->nb[1], offs - prev_offs);
+            prev = ggml_cpy(ctx, last_conv, dst);
+            prev_offs = offs;
+            check_nodes.push_back(prev);
+        }
+
+        ggml_tensor * out = ggml_silu(ctx, ggml_add(ctx, ggml_ssm_conv(ctx, conv_x, w), bias));
+        check_nodes.push_back(out);
+
+        // read the cache after the last cpy so the copies are part of the graph
+        ggml_tensor * tail = ggml_view_1d(ctx, prev, ggml_nelements(out), 0);
+        ggml_tensor * res  = ggml_add(ctx, ggml_reshape(ctx, tail, out), out);
+        check_nodes.push_back(res);
+        return res;
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SSM_CONV_CAT_FUSION";
+    }
+
+    bool run_whole_graph() override { return true; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override { return check_nodes; }
+};
