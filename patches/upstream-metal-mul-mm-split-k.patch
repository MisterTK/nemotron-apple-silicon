+// the mat-mat kernel splits K until it has about this many threadgroups (tuned on an M3 Max with 16-64 src1 rows)
+static constexpr int64_t GGML_METAL_MM_SK_MIN_TG = 512;
+
+// K elements per split are a multiple of 256 (a whole number of blocks of every type), at least 512
+static constexpr int64_t GGML_METAL_MM_SK_ALIGN  = 256;
+static constexpr int64_t GGML_METAL_MM_SK_MIN_K  = 2*GGML_METAL_MM_SK_ALIGN;
+static constexpr int     GGML_METAL_MM_SK_MAX    = 16;
+
+static int64_t ggml_metal_op_mul_mat_nkc(const ggml_tensor * op) {
+    const int64_t ne00 = op->src[0]->ne[0];
+
+    const int64_t tiles = ((op->ne[1] + 31)/32)*((op->ne[0] + 63)/64)*op->ne[2]*op->ne[3];
+    if (tiles >= GGML_METAL_MM_SK_MIN_TG || ne00 < 2*GGML_METAL_MM_SK_MIN_K || op->src[1]->ne[1] <= 8) {
+        return ne00;
+    }
+
+    const int64_t nsk = std::min<int64_t>({ (GGML_METAL_MM_SK_MIN_TG + tiles - 1)/tiles, ne00/GGML_METAL_MM_SK_MIN_K, GGML_METAL_MM_SK_MAX });
+
+    return ((ne00 + nsk*GGML_METAL_MM_SK_ALIGN - 1)/(nsk*GGML_METAL_MM_SK_ALIGN))*GGML_METAL_MM_SK_ALIGN;
+}
+
+int ggml_metal_op_mul_mat_nsk(const ggml_tensor * op) {
+    const int64_t nkc = ggml_metal_op_mul_mat_nkc(op);
+
+    return (int) ((op->src[0]->ne[0] + nkc - 1)/nkc);
+}
