+// sums the nsk partial results of a K-split kernel_mul_mm
+kernel void kernel_mul_mm_sk_reduce(
+        constant ggml_metal_kargs_mul_mm_sk_reduce & args,
+        device const float * src,
+        device       float * dst,
+        uint tpig[[thread_position_in_grid]]) {
+    if ((int) tpig >= args.n) {
+        return;
+    }
+
+    float sum = 0.0f;
+    for (int s = 0; s < args.nsk; ++s) {
+        sum += src[(uint64_t) s*args.n + tpig];
+    }
+
+    dst[tpig] = sum;
+}
