+// SSM_SCAN + CPY: the scan writes its final state (and rollback snapshots) straight into the
+// recurrent cache instead of the tail of its output, and the cpy is skipped
+static bool ggml_metal_fusion_check_ssm_scan_cache(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * scan = nodes[0];
+    const ggml_tensor * cpy  = nodes[fusion->ops.size() - 1];
+
+    // the graph optimizer also sees build_rs's extra-state GET_ROWS + CPY between the scan and the
+    // state cpy; at decode they have no elements, so the encoders (which skip empty nodes) see SSM_SCAN + CPY
+    if (fusion->ops.size() == 4 && (!ggml_is_empty(nodes[1]) || !ggml_is_empty(nodes[2]))) {
+        return false;
+    }
+
+    if (scan->type != GGML_TYPE_F32 || (scan->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    if (cpy->op != GGML_OP_CPY || (cpy->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const ggml_tensor * x = scan->src[1];
+
+    const int64_t D         = scan->src[0]->ne[0]*scan->src[0]->ne[1]*scan->src[0]->ne[2]; // d_state*head_dim*n_head
+    const int64_t n_tokens  = x->ne[2];
+    const int64_t n_seqs    = x->ne[3];
+    const int64_t K         = ggml_get_op_params_i32(scan, 0);
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+    const size_t  tail_off  = ggml_nelements(x)*sizeof(float);
+
+    const ggml_tensor * src = cpy->src[0]; // scan state tail view
+    const ggml_tensor * dst = cpy->src[1]; // cache view
+
+    if (src->op != GGML_OP_VIEW || src->view_src != scan ||
+        src->view_offs != tail_off || !ggml_is_contiguous(src) ||
+        ggml_nelements(src) != D*n_seqs*n_written) {
+        return false;
+    }
+
+    const int64_t expected_ne[GGML_MAX_DIMS] = { D, n_seqs, n_written, 1 };
+    if (dst->type != GGML_TYPE_F32 ||
+        !std::equal(expected_ne, expected_ne + GGML_MAX_DIMS, dst->ne) ||
+        dst->nb[0] != ggml_type_size(GGML_TYPE_F32) ||
+        dst->nb[1] != ggml_row_size(GGML_TYPE_F32, D)) {
+        return false;
+    }
+
+    if (mode == GGML_METAL_FUSION_FULL) {
+        // the cache must be allocated so the kernel can write straight to its buffer
+        if (dst->data == nullptr) {
+            return false;
+        }
+
+        // each sequence reads its whole state into registers before writing, so in-place is safe for a
+        // single sequence. with several, one sequence may read a cache row that another one writes
+        // (cell swaps, the shared zero state); the row ids are graph inputs that are already set when the
+        // graph is encoded, so check them on the host (shared buffers only) and skip the fusion if so
+        if (n_seqs > 1) {
+            const ggml_tensor * ids = scan->src[6];
+            if (ids == nullptr || ids->type != GGML_TYPE_I32 || ids->buffer == nullptr || ids->data == nullptr ||
+                strncmp(ggml_backend_buffer_name(ids->buffer), "MTL", 3) != 0 ||
+                !ggml_metal_buffer_is_shared((ggml_metal_buffer_t) ids->buffer->context)) {
+                return false;
+            }
+
+            const int64_t row_size = dst->nb[1];
+            const int64_t head     = dst->view_offs / row_size;    // first written row
+            const int64_t slot_rows = dst->nb[2] / row_size;       // rows between snapshot slots (mem_size)
+            const int32_t * rows = (const int32_t *) ids->data;
+
+            for (int64_t i = 0; i < n_seqs; ++i) {
+                const int64_t slot = rows[i] / slot_rows;
+                const int64_t cell = rows[i] % slot_rows - head;
+                if (slot < n_written && cell >= 0 && cell < n_seqs && cell != i) {
+                    return false;
+                }
+            }
+        }
+    }
+
+    return true;
+}
+
+// CONCAT(conv state, x) + CPY x m (state + rollback snapshots into the cache) + SSM_CONV + ADD(bias) + UNARY(silu)
+// the fused kernel keeps each channel's conv window in registers, so the concat result is never materialized
+static bool ggml_metal_fusion_check_ssm_conv_cat(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(mode);
+
+    const int n = (int) fusion->ops.size();
+    const int m = n - 4; // number of cache cpys
+
+    const ggml_tensor * cat  = nodes[0];
+    const ggml_tensor * conv = nodes[m + 1];
+    const ggml_tensor * add  = nodes[m + 2];
+    const ggml_tensor * un   = nodes[m + 3];
+
+    if (cat->type != GGML_TYPE_F32 || ggml_get_op_params_i32(cat, 0) != 0 || cat->ne[3] != 1) {
+        return false;
+    }
+
+    const ggml_tensor * st = cat->src[0]; // conv state (d_conv - 1, n_ch, n_seqs)
+    const ggml_tensor * x  = cat->src[1]; // new tokens (n_t, n_ch, n_seqs)
+
+    const int64_t ncs  = st->ne[0];
+    const int64_t n_t  = x->ne[0];
+    const int64_t n_ch = cat->ne[1];
+    const int64_t n_s  = cat->ne[2];
+
+    if (st->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 || ncs < 1 || ncs > 3 || n_t < 1 || n_t > 16 || m > n_t) {
+        return false;
+    }
+
+    if (conv->op != GGML_OP_SSM_CONV || conv->src[0] != cat) {
+        return false;
+    }
+
+    const ggml_tensor * cw = conv->src[1];
+    if (cw->type != GGML_TYPE_F32 || cw->ne[0] != ncs + 1 || cw->ne[1] != n_ch || !ggml_is_contiguous(cw)) {
+        return false;
+    }
+
+    const ggml_tensor * bias = add->src[1];
+    if (add->op != GGML_OP_ADD || add->src[0] != conv || add->type != GGML_TYPE_F32 || !ggml_are_same_shape(add, conv) ||
+        bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || ggml_nelements(bias) != n_ch) {
+        return false;
+    }
+
+    if (un->op != GGML_OP_UNARY || ggml_get_unary_op(un) != GGML_UNARY_OP_SILU || un->src[0] != add || un->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    // the intermediates must have no other consumers (the concat is used by the m cpy views and the conv)
+    if (ggml_node_get_use_count(gf, node_idxs[idx]) != m + 1 ||
+        ggml_node_get_use_count(gf, node_idxs[idx + m + 1]) != 1 ||
+        ggml_node_get_use_count(gf, node_idxs[idx + m + 2]) != 1) {
+        return false;
+    }
+
+    for (int j = 0; j < n - 1; ++j) {
+        if (nodes[j]->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+    }
+
+    // cpy j stores the window ending j tokens before the last one into snapshot slot j of the cache
+    const ggml_tensor * cache = nullptr;
+    size_t off0  = 0;
+    size_t slot  = 0;
+    for (int j = 0; j < m; ++j) {
+        const ggml_tensor * cpy = nodes[1 + j];
+        if (cpy->op != GGML_OP_CPY) {
+            return false;
+        }
+
+        const ggml_tensor * v = cpy->src[0];
+        if (v->op != GGML_OP_VIEW || v->view_src != cat || v->view_offs != (size_t) (n_t - j)*cat->nb[0] ||
+            v->ne[0] != ncs || v->ne[1] != n_ch || v->ne[2] != n_s || v->nb[1] != cat->nb[1] || v->nb[2] != cat->nb[2]) {
+            return false;
+        }
+
+        const ggml_tensor * d = cpy->src[1];
+        if (d->type != GGML_TYPE_F32 || d->op != GGML_OP_VIEW || d->view_src == nullptr ||
+            d->ne[0] != ncs*n_ch || d->ne[1] != n_s || d->ne[2] != 1 || d->nb[0] != sizeof(float)) {
+            return false;
+        }
+
+        if (j == 0) {
+            cache = d->view_src;
+            off0  = d->view_offs;
+        } else {
+            if (d->view_src != cache || d->nb[1] != nodes[1]->src[1]->nb[1] || d->view_offs <= off0) {
+                return false;
+            }
+            if (j == 1) {
+                slot = d->view_offs - off0;
+            } else if (d->view_offs != off0 + j*slot) {
+                return false;
+            }
+        }
+    }
+
+    // the state is read before the cache is written only within a thread, so it must not come from the cache itself
+    for (const ggml_tensor * t = st; t; t = t->view_src) {
+        if (t == cache) {
+            return false;
+        }
+    }
+    for (const ggml_tensor * t = x; t; t = t->view_src) {
+        if (t == cache) {
+            return false;
+        }
+    }
+
+    return true;
+}
