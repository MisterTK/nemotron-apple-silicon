+// few-token scan (decode, speculative verify): one simdgroup per head_dim row, the row's state stays in
+// registers (lane holds d_state/32 entries) across tokens, so it is read and written once; no barriers
+kernel void kernel_ssm_scan_f32_rows(
+        constant ggml_metal_kargs_ssm_scan & args,
+        device const void * src0,
+        device const void * src1,
+        device const void * src2,
+        device const void * src3,
+        device const void * src4,
+        device const void * src5,
+        device const void * src6,
+        device      float * dst,
+        device      char  * dst_s, // final state + snapshots: the tail of dst, or the recurrent cache when fused
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgptg[[simdgroups_per_threadgroup]]) {
+    constexpr short NS_MAX = 8; // d_state <= 256
+
+    const int32_t i1 = tgpig.x*sgptg + sgitg; // row within the head
+    const int32_t ir = tgpig.y;               // head
+    const int32_t i3 = tgpig.z;               // seq
+
+    const int32_t nc  = args.d_state;
+    const int32_t nr  = args.d_inner;
+    const int32_t nh  = args.n_head;
+    const int32_t ng  = args.n_group;
+    const int32_t n_t = args.n_seq_tokens;
+    const int32_t n_s = args.n_seqs;
+    const int32_t K   = args.K;
+    const short   nk  = nc/N_SIMDWIDTH;
+
+    if (i1 >= nr) {
+        return;
+    }
+
+    device const int32_t * ids = (device const int32_t *) src6;
+
+    device       float * s_buff  = (device       float *) (dst_s + ir*args.nb02 +      i3*args.nb03 + args.s_off)          + i1*nc;
+    device const float * s0_buff = (device const float *) ((device const char *) src0 + ir*args.nb02 + ids[i3]*args.nb03) + i1*nc;
+
+    const int32_t g = ir / (nh / ng);
+
+    device const float * A  = (device const float *) ((device const char *) src3 + ir*args.nb31);
+    device const float * x  = (device const float *) ((device const char *) src1 + i1*args.nb10 + ir*args.nb11 + i3*args.nb13);
+    device const float * dt = (device const float *) ((device const char *) src2 + ir*args.nb20 + i3*args.nb22);
+    device const float * B  = (device const float *) ((device const char *) src4 + g*args.nb41 + i3*args.nb43);
+    device const float * C  = (device const float *) ((device const char *) src5 + g*args.nb51 + i3*args.nb53);
+
+    device float * y = dst + (i1 + ir*nr + i3*(n_t*nh*nr));
+
+    float s[NS_MAX];
+    float a[NS_MAX];
+
+    FOR_UNROLL (short k = 0; k < NS_MAX; ++k) {
+        if (k < nk) {
+            s[k] = s0_buff[tiisg + k*N_SIMDWIDTH];
+            a[k] = A[(tiisg + k*N_SIMDWIDTH) % args.ne30];
+        }
+    }
+
+    for (int32_t t = 0; t < n_t; ++t) {
+        const float dt0  = dt[0];
+        const float dtsp = dt0 <= 20.0f ? log(1.0f + exp(dt0)) : dt0;
+        const float x_dt = x[0] * dtsp;
+
+        float sumf = 0.0f;
+
+        FOR_UNROLL (short k = 0; k < NS_MAX; ++k) {
+            if (k < nk) {
+                const int32_t j = tiisg + k*N_SIMDWIDTH;
+                s[k] = s[k] * exp(dtsp * a[k]) + B[j] * x_dt;
+                sumf += s[k] * C[j];
+            }
+        }
+
+        // rollback snapshots for speculative decoding (see kernel_ssm_scan_impl)
+        const int32_t slot = n_t - 1 - t;
+        if (slot > 0 && slot < K) {
+            device float * s_snapshot = (device float *) ((device char *) s_buff + (int64_t) slot*args.nb_s_slot);
+            FOR_UNROLL (short k = 0; k < NS_MAX; ++k) {
+                if (k < nk) {
+                    s_snapshot[tiisg + k*N_SIMDWIDTH] = s[k];
+                }
+            }
+        }
+
+        sumf = simd_sum(sumf);
+
+        if (tiisg == 0) {
+            y[t*nh*nr] = sumf;
+        }
+
+        x  += args.ns12;
+        dt += args.ns21;
+        B  += args.ns42;
+        C  += args.ns52;
+    }
+
+    FOR_UNROLL (short k = 0; k < NS_MAX; ++k) {
+        if (k < nk) {
+            s_buff[tiisg + k*N_SIMDWIDTH] = s[k];
+        }
+    }
+}
